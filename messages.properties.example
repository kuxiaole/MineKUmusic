# MineKUmusic 聊天语言与配色（UTF-8）
# 网易云音源的显示名称，用于歌曲详情和账号配置状态。
source.netease=网易云音乐
# QQ 音源的显示名称，用于歌曲详情和账号配置状态。
source.qq=QQ 音乐
# 音源账号接口无法连接或没有正常响应。
result.auth-network=<error>音源账号请求失败，请检查服务端网络后重试。</error>
# 音源账号接口返回的数据无法解析。
result.auth-response=<error>音源账号返回的数据无法识别，请稍后重试。</error>
# 匿名音源请求失败。
result.source-network=<error>音源请求失败，请检查服务端网络后重试。</error>
# 全服多音源提示：该音源或歌曲 ID 不受全服频道支持。
result.source-unsupported=<error>该音源或歌曲 ID 不受全服频道支持。</error>
# 全服多音源提示：请更新 MineKU Music 客户端后点播此音源。
result.source-update=<error>请更新 MineKU Music 客户端后点播此音源。</error>
# 全服多音源提示：服务端 QQ 音乐 Cookie 不完整，请管理员重新扫码登录。
result.qq-cookie-incomplete=<error>服务端 QQ 音乐 Cookie 不完整，请管理员重新扫码登录。</error>
# 全服多音源提示：QQ 音乐搜索失败，请稍后重试。
result.qq-search=<error>QQ 音乐搜索失败，请稍后重试。</error>
# 全服多音源提示：未找到这首 QQ 音乐歌曲。
result.qq-song=<error>未找到这首 QQ 音乐歌曲。</error>
# 全服多音源提示：QQ 音乐请求失败，请重试或让管理员重新登录。
result.qq-request=<error>QQ 音乐请求失败，请重试或让管理员重新登录。</error>
# 全服多音源提示：QQ 音乐返回的数据不完整，请重试。
result.qq-response=<error>QQ 音乐返回的数据不完整，请重试。</error>
# 全服多音源提示：QQ 音乐播放地址请求失败，请重试。
result.qq-playback=<error>QQ 音乐播放地址请求失败，请重试。</error>
# 全服多音源提示：服务端 QQ 音乐登录已失效，请管理员重新扫码。
result.qq-expired=<error>服务端 QQ 音乐登录已失效，请管理员重新扫码。</error>
# 全服多音源提示：QQ 音乐未返回可播放的完整 MP3，请检查账号播放权限或选择其他版本。
result.qq-no-mp3=<error>QQ 音乐未返回可播放的完整 MP3，请检查账号播放权限或选择其他版本。</error>
# 全服多音源提示：服务端 netease-cookie.json 格式错误，请使用浏览器导出的 Cookie JSON 数组。
result.cookie-netease=<error>服务端 netease-cookie.json 格式错误，请使用浏览器导出的 Cookie JSON 数组。</error>
# 全服多音源提示：服务端 qq-cookie.json 格式错误，请使用浏览器导出的 Cookie JSON 数组。
result.cookie-qq=<error>服务端 qq-cookie.json 格式错误，请使用浏览器导出的 Cookie JSON 数组。</error>
# 全服多音源提示：此音源已有管理员正在扫码，请等待完成或取消。
result.login-busy=<error>此音源已有管理员正在扫码，请等待完成或取消。</error>
# 全服多音源提示：请先关闭当前的全服账号扫码弹窗，再登录其他音源。
result.login-close=<error>请先关闭当前的全服账号扫码弹窗，再登录其他音源。</error>
# 全服多音源提示：你没有管理全服音乐账号的权限。
result.login-permission=<error>你没有管理全服音乐账号的权限。</error>

# login 子命令说明：只能由游戏内管理员扫码，不接受玩家上传 Cookie。
command.login.description=为全服音乐登录网易云或 QQ 音乐，或查看、取消扫码状态。
# login 参数说明；音源值固定为 netease、qq。
command.login.arguments=<netease|qq|status [音源]|cancel [音源]>
# 控制台无法显示客户端二维码。
login.player-only=<error>请由安装 MineKU Music 1.7.0 客户端的管理员在游戏内执行扫码登录。</error>
# 管理员客户端尚未完成扫码能力握手。
login.client-required=<error>请安装或更新至 MineKU Music 1.7.0，并进入服务器后重试。</error>
# 手动取消扫码后的提示。
login.cancelled=<muted>已取消你尚未确认完成的全服账号扫码登录。</muted>
# 文件中存在账号配置；{source} 为音源显示名称。此指令不联网验证账号有效性。
login.configured=<success>{source}：已配置 Cookie 文件；账号是否有效以音源实际返回为准。</success>
# 文件未配置账号；{source} 为音源显示名称。
login.missing=<muted>{source}：未配置账号，当前使用匿名模式。</muted>
# 文件格式不正确；{source} 为音源显示名称。
login.invalid=<error>{source}：Cookie JSON 文件无效，请检查对应音源文件或重新扫码。</error>
# 修改后执行 /minekumusic reload；Velocity 和各 Paper / Folia 后端分别读取自身数据目录。
# 支持 <red>文字</red>、<#A78BFA>文字</#A78BFA>、<bold>粗体</bold>、<underlined>下划线</underlined>、<newline>换行。
# 主题色用 <brand>、<heading>、<primary>、<action>、<muted>、<disabled>、<error>、<success>，非换行标签必须闭合。
# 不支持 & 颜色码、reset、click、hover 等标签；按钮动作由插件保持，语言配置只修改显示。
# {占位符} 只能使用各项注释列出的名字，可以重排或省略。动态歌曲名、玩家名不会解析成标签。
# 修改每项等号右侧的值；不要改键名。空值显示空文字；chat.prefix 可留空。帮助参数 arguments 是普通文本。
# 错误标签、未知占位符或无效颜色会拒绝本次重载，保留原运行配置和语言；错误项会显示在提示中。
# 普通重载保留文件排版和自定义注释；升级补齐新项目时重新附上中文注释并保留已有值。

# 品牌色：标题和前缀。支持英文颜色名或 #RRGGBB，例如 #C084FC。
color.brand=light_purple

# 重点色：标题副文、指令与页码，例如 #FBBF24。
color.heading=gold

# 正文色：歌曲名、常规提示和悬浮说明，例如 #FDE68A。
color.primary=yellow

# 操作色：可点击按钮，例如 #67E8F9。
color.action=aqua

# 次要文字色：歌手、说明和辅助信息，例如 #A1A1AA。
color.muted=gray

# 不可用按钮、分隔线和歌曲 ID 的颜色，例如 #71717A。
color.disabled=dark_gray

# 错误色：权限、输入和加载失败，例如 #F87171。
color.error=red

# 成功色：扣款、入队与配置重载成功，例如 #86EFAC。
color.success=green

# 普通提示前缀，可留空；帮助和搜索列表不逐行添加。
chat.prefix=<brand>[MineKUmusic] </brand>

# 标题格式；{title} 为当前页面标题。
chat.title=<disabled>━━ </disabled><brand><bold>MineKU Music</bold></brand><heading> · {title}</heading><disabled> ━━</disabled>

# 未定义专用模板的普通提示；{text} 为原始内容。
notice.text=<primary>{text}</primary>

# 外部服务或未定义错误；{text} 为原始错误，不会解析其中格式。
error.text=<error>{text}</error>

# 可点击按钮外观；{label} 为按钮文字，点击动作固定由插件处理。
button.label=<action><underlined>[{label}]</underlined></action>

# 不可点击按钮；{label} 为按钮文字。
button.disabled=<disabled>[{label}]</disabled>

# 翻页按钮之间的分隔文字。
button.separator=<disabled>  |  </disabled>

# 帮助页标题。
help.title=指令帮助

# 主指令与别名说明，修改文字不会注册新指令。
help.aliases=<muted>主指令：/minekumusic  别名：/music、/kum</muted>

# 帮助主题不存在或无权查看时的提示。
help.unavailable=<error>没有可用的对应指令，请使用 /minekumusic help 查看你能使用的指令。</error>

# 每条帮助的格式；{usage} 为用法，{description} 为指令说明。
help.row=<heading>{usage}</heading><primary> — {description}</primary>

# 立即执行按钮文字。
help.run=执行

# 填入聊天输入框按钮文字。
help.suggest=填入指令

# 立即执行悬浮说明；{description} 为说明，{command} 为实际指令。
help.run-hover=<primary>{description}<newline>点击执行：{command}</primary>

# 填入指令悬浮说明；{description} 为说明，{command} 为实际指令。
help.suggest-hover=<primary>{description}<newline>点击填入聊天输入框：{command}</primary>

# reload 详细帮助第一行。
help.reload-settings=<muted>可热重载：语言、配色、频道名称、队列上限、冷却、同步间隔、收费开关、价格和币名。</muted>

# reload 详细帮助第二行。
help.reload-restart=<muted>server-id、economy-bridge-only、economy-bridge-secret 变更需重启；配置或语言错误时继续使用原设置。</muted>

# 经济桥接模式说明。
help.bridge=<muted>当前为经济桥接后端，音乐队列由 Velocity 管理；请在代理端执行音乐指令。</muted>

# 普通帮助页末尾说明。
help.footer=<muted>使用 /music join 或聊天公告按钮加入收听，也可在客户端“全服音乐”页面加入或退出。Tab 可补全子命令、页码和待播条目 ID。</muted>

# 点歌成功后向所有在线玩家广播；{player} 为点歌人，{song} 为缩略歌名，{artists} 为缩略歌手，{channel} 为频道名称。
request.announcement=<heading>{player}</heading><primary> 点了《{song}》</primary><muted> · {artists}，已加入「{channel}」播放队列。</muted>

# 点歌公告中加入频道的按钮文字；点击动作固定为 /minekumusic join，仅加入收听，不点歌或扣款。
join.button=点击加入全服音乐

# 加入频道按钮的悬浮说明。
join.hover=<primary>免费加入全服音乐频道，退出后恢复个人播放。需要安装支持聊天加入的 MineKU Music 客户端。</primary>

# 点击加入后通知客户端切换频道；{channel} 为频道名称。
join.connecting=<success>正在加入「{channel}」，收听免费。</success>

# 已在收听时再次点击，不改变个人播放快照或暂停状态。
join.already=<muted>你已经加入全服音乐频道。</muted>

# 玩家没有与插件完成客户端握手。
join.client-missing=<error>尚未连接 MineKU Music 客户端，请安装或启用模组，进入服务器后稍候重试。</error>

# 旧客户端不支持聊天按钮加入，仍可使用原有界面加入。
join.client-update=<primary>请将 MineKU Music 客户端更新至 1.6.9 或更高版本以使用聊天加入，也可在音乐界面的“全服音乐”页面手动加入。</primary>

# join 子命令说明。
command.join.description=免费加入全服音乐频道，需要支持聊天加入的客户端。

# 搜索列表标题。
search.title=搜索结果 · 免费

# 搜索信息；{query} 为关键词，{page} 从 1 开始。
search.heading=<muted>关键词：</muted><primary>{query}</primary><heading>  第 {page} 页</heading>

# 结果行；{index} 为序号，{name} 和 {artists} 为缩略歌名、歌手，{id} 为歌曲 ID。
search.row=<muted>{index}. </muted><primary>{name}</primary><muted> · {artists}</muted><disabled>  #{id}</disabled>

# 结果悬浮信息；{name} 和 {artists} 保留完整内容，{id} 为音源原始歌曲 ID，{source} 为音源名称。
search.detail=<primary>{name}<newline>音源：{source}<newline>歌手：{artists}<newline>歌曲 ID：{id}</primary>

# 搜索结果点歌按钮。
search.request=点歌

# 点歌按钮悬浮说明；{detail} 为完整歌曲信息。
search.request-hover={detail}<newline><primary>点击后在客户端确认点歌费用，确认前不扣款。</primary>

# 搜索第一页无结果。
search.empty=<muted>没有找到匹配的歌曲，请更换关键词。</muted>

# 上一页按钮文字。
search.previous=上一页

# 上一页悬浮说明。
search.previous-hover=<primary>查看上一页搜索结果（免费）</primary>

# 下一页按钮文字。
search.next=下一页

# 下一页悬浮说明。
search.next-hover=<primary>查看下一页搜索结果（免费）</primary>

# 重新搜索按钮文字。
search.again=重新搜索

# 重新搜索悬浮说明。
search.again-hover=<primary>在聊天输入框填写新的搜索关键词</primary>

# 搜索列表末尾说明。
search.footer=<muted>搜索与翻页免费；点歌需加入频道，并在客户端确认费用。</muted>

# 开始搜索提示；{query} 为关键词，{page} 从 1 开始。
search.loading=<primary>正在搜索「{query}」第 {page} 页（免费）……</primary>

# 搜索失败；{reason} 为原因。
search.failed=<error>搜索失败：{reason}；可重新搜索或再次翻页。</error>

# 后续页面无结果。
search.no-more=<primary>此页没有更多歌曲，请返回上一页或更换关键词。</primary>

# 搜索关键词不合法。
search.invalid=<error>搜索关键词需为 1～120 个字符。</error>

# 搜索尚未完成。
search.busy=<error>正在搜索，请稍候再操作。</error>

# 旧搜索的翻页按钮失效。
search.expired=<error>搜索结果已过期或已更新，请使用 /minekumusic search 关键词 重新搜索。</error>

# 搜索页码不合法。
search.invalid-page=<error>没有对应的搜索结果页，请使用结果下方的翻页按钮。</error>

# 投票提示；{song} 为歌名，{votes} 为票数，{required} 为门槛，{listeners} 为频道人数。
vote.prompt=<primary>《{song}》切歌投票 {votes}/{required}（{listeners} 人收听，达到 15% 即切歌）</primary>

# 投票按钮文字。
vote.button=点击投票切歌

# 投票按钮悬浮说明。
vote.hover=<primary>为当前歌曲投一票，每人限一票</primary>

# 投票通过；占位符与 vote.prompt 相同，仅改变展示文字不会改变 15% 规则。
vote.passed=<success>切歌投票已通过（{votes}/{required}，收听人数 {listeners}，阈值 15%），已跳过《{song}》</success>

# 当前无歌曲。
queue.empty=<muted>当前没有正在播放的歌曲。</muted>

# 当前歌曲；{song} 为歌名。
queue.current=<primary>正在播放：{song}</primary>

# 队列页标题；{page} 为当前页，{pages} 为总页数，{count} 为待播数量。
queue.heading=<heading>待播队列：第 {page}/{pages} 页，共 {count} 首。</heading><muted>条目格式：队列条目ID | 歌曲 | 点歌人</muted>

# 队列条目；{entry} 为条目 ID，{song} 为歌名，{player} 为点歌人。
queue.row=<disabled>{entry}</disabled><primary> | {song}</primary><muted> | {player}</muted>

# 队列页码错误；{pages} 为总页数。
queue.invalid-page=<error>页码超出范围，请输入 1～{pages}。</error>

# 指令撤回成功。
queue.withdrawn=<success>已撤回待播歌曲；已支付的点歌费用不自动退还。</success>

# 未知或当前模式不支持的指令。
command.unknown=<error>未知或不适用于当前服务器的指令，请使用 /minekumusic help 查看帮助。</error>

# 权限不足或调用身份不支持。
command.denied=<error>你没有权限使用该指令，或该指令仅限游戏内玩家使用。</error>

# 不支持的指令发送者。
command.sender=<error>此指令仅支持玩家或服务器控制台。</error>

# 参数数量错误；{usage} 为当前指令用法。
command.usage=<error>用法：{usage}</error>

# 数字参数错误；{usage} 为当前指令用法。
command.number=<error>参数必须是有效的数字。用法：{usage}</error>

# 音乐服务尚未启动。
command.not-ready=<error>音乐服务尚未就绪，请检查插件启动日志。</error>

# 代理端无法核对交易。
command.backend=<error>交易核对请在原扣款 Paper / Folia 后端控制台执行 minekumusic payment 交易ID paid或cancel。</error>

# 管理员切歌通知；{song} 为被跳过歌曲。
admin.skipped=<primary>管理员已跳过《{song}》</primary>

# 管理员操作成功。
admin.updated=<success>音乐频道已更新。</success>

# 已有重载正在执行。
reload.busy=<primary>配置正在重载，请稍候。</primary>

# 重载开始。
reload.loading=<primary>正在重载 MineKUmusic 配置、语言和配色……</primary>

# 重载失败；{reason} 为具体文件或配置项错误。
reload.failed=<error>配置重载失败，当前配置和语言继续生效：{reason}</error>

# 普通模式重载成功。
reload.success=<success>配置重载成功，语言和配色已更新。队列、播放进度、收听状态和交易记录已保留；降低上限不会删除已入队歌曲。</success>

# 价格变更通知。
reload.pricing=<primary>点歌费用已更新，未确认的报价已失效，请重新选择歌曲。已确认的点歌按原报价处理。</primary>

# 桥接模式重载成功。
reload.bridge=<success>经济桥接配置、语言和配色重载成功，交易记录已保留。频道及收费规则请在 Velocity 执行 /minekumusic reload。</success>

# 核对交易指令用法；{usage} 为实际用法。
payment.usage=<error>用法：{usage}；请先核对经济插件交易记录。</error>

# 经济插件不可用。
payment.unavailable=<error>经济服务不可用，请检查 Vault 和经济插件。</error>

# 收费点歌成功；{amount} 为实扣金额，{currency} 为币名。
payment.paid=<success>歌曲已加入队列，已扣除 {amount} {currency}。</success>

# 待核对的交易；{reason} 为状态说明，{transaction} 为交易 ID。
payment.pending=<primary>{reason} [{transaction}]</primary>

# 控制台交易状态；{status} 为详细状态，{player} 为玩家 UUID，{backend} 为扣款后端。
payment.console={status}<muted> 玩家={player} 后端={backend}</muted>

# 歌曲解析失败；{song} 为歌名，{reason} 为原因。
audio.failed=<error>《{song}》播放失败：{reason}</error>

# 通信版本或消息不完整提示。
protocol.invalid=<error>音乐消息不兼容或不完整，请检查客户端版本。</error>


# help 指令参数的显示文字，不改变指令实际语法。
